---
interface Props {
	frontmatter?: {
		title: string;
		date?: string;
		description?: string;
		[key: string]: any;
	};
	title?: string;
	date?: string;
	description?: string;
}

const { frontmatter, ...props } = Astro.props;

const title = frontmatter?.title || props.title;
const date = frontmatter?.date || props.date;
const description = frontmatter?.description || props.description;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
		
		<link 
			rel="stylesheet" 
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
			integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" 
			crossorigin="anonymous"
		/>
	</head>
	<body class="bg-slate-50 font-sans selection:bg-blue-200">
		
		<nav class="sticky top-0 z-50 w-full h-20" style="background: linear-gradient(to bottom, #e0f2fe 0%, #e0f2fe 60%, #e8f5e4 100%);">
			<div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
				
				<div class="flex items-center gap-4">
					<div id="header-stack" class="relative w-8 h-8 flex items-end overflow-hidden">
						<div class="absolute bottom-[2px] w-full h-[1px] bg-slate-400/30"></div>
						<div class="absolute bottom-[4px] w-full h-[1px] bg-slate-400/40"></div>
						<div class="absolute bottom-[6px] w-full h-[1px] bg-slate-400/50"></div>
						<div class="absolute bottom-[8px] w-full h-[1px] bg-slate-400/60"></div>
						
						<div id="paper-1" class="absolute w-full h-[1px] bg-slate-500" style="transform: translateY(-40px); opacity: 0;"></div>
						<div id="paper-2" class="absolute w-full h-[1px] bg-slate-500" style="transform: translateY(-40px); opacity: 0;"></div>
					</div>

					<a href={`${base}/`} class="text-xl md:text-3xl font-serif italic tracking-tight text-[#bdaa8b]">Stackin Paper</a>
				</div>

				<div class="flex gap-8 font-mono text-m font-bold uppercase text-[#bdaa8b]">
					<a href={`${base}/researchlog`} class="hover:text-blue-600 transition-colors">/logs</a>
				</div>
			</div>
		</nav>

		<main class="max-w-3xl mx-auto px-6 py-12">
			<header class="mb-8 pb-6 border-b border-slate-200/60">
				{date && <time class="block mb-2 text-sm font-mono text-slate-500">{date}</time>}
				
				<h1 class="mb-3 text-3xl sm:text-4xl font-bold text-[#bdaa8b]">{title}</h1>
				
				{description && <p class="text-base text-slate-600 leading-relaxed">{description}</p>}
			</header>

			<article class="prose prose-slate max-w-3xl mx-auto prose-headings:text-black [&>*:first-child]:!mt-0 break-words subpixel-antialiased">
				<slot />
			</article>

		</main>

		<script>
			const p1 = document.getElementById('paper-1');
			const p2 = document.getElementById('paper-2');
			
			let lastScrollY = window.scrollY;
			let totalDelta = 0;

			window.addEventListener('scroll', () => {
				const currentScrollY = window.scrollY;
				totalDelta += Math.abs(currentScrollY - lastScrollY);
				lastScrollY = currentScrollY;

				const loopDistance = 140; 
				
				const progress1 = (totalDelta % loopDistance) / loopDistance;
				const progress2 = ((totalDelta + (loopDistance / 2)) % loopDistance) / loopDistance;

				const animate = (el, progress) => {
					if (!el) return;
					const y = -30 + (progress * 30);
					const opacity = progress < 0.1 ? progress * 10 : (1 - progress) * 1.5;
					
					el.style.transform = `translateY(${y}px)`;
					el.style.opacity = opacity.toString();
				};

				animate(p1, progress1);
				animate(p2, progress2);
			});
		</script>
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;

	html, body {
		background-color: #e8f5e4 !important; 
		margin: 0;
		padding: 0;
		min-height: 200vh;
	}

	/* Prevents wide LaTeX formulas from breaking layout while keeping them centered */
	.katex-display {
		display: block; /* Restores KaTeX's default layout */
		text-align: center; /* Ensures the inner math nodes are centered */
		width: 100%;
		margin: 1.5rem 0 !important;
		overflow-x: auto;
		overflow-y: hidden;
		padding-top: 0.5rem; /* Optional: prevents vertical clipping of tall math (e.g. integrals/fractions) during overflow */
		padding-bottom: 0.5rem;
	}
</style>